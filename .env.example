# ─────────────────────────────────────────────────────────────────────────────
# WebThangs Business Operations Planner — environment variables
# Copy the values you need. NEVER put a real API key in this file or commit it.
#
#  • Local development with Cloudflare Pages Functions:
#      copy this file to `.dev.vars` (already gitignored) and fill in values.
#      `wrangler pages dev` reads `.dev.vars` automatically.
#
#  • Production (Cloudflare Pages):
#      Dashboard → Workers & Pages → your project → Settings →
#      Variables and Secrets → Add. Set GEMINI_API_KEY as an ENCRYPTED secret.
#      See docs/DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED for AI personalization. Server-side only — never exposed to the browser.
# Temporary TEST key from Google AI Studio: https://aistudio.google.com/apikey
# Replace with a freshly generated key before public launch.
GEMINI_API_KEY=replace-with-your-temporary-test-key

# Gemini model used to personalize the blueprint. Must exist in the Gemini API
# model list for your API project (check https://ai.google.dev/gemini-api/docs/models).
# gemini-3.8-flash is a current stable Flash model (verified Oct 2026 against
# the official model list).
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated fallback models tried (in order) when GEMINI_MODEL is not
# available for your API key. "gemini-flash-latest" is a maintained alias.
# Verified Oct 2026: gemini-2.5-flash is limited-access for API projects that
# have not used it before, so the default chain no longer ends with it.
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.6-flash

# Where consultation requests are routed when no D1 database is configured.
# Shown to the visitor ONLY after an honest "we could not store this automatically"
# response, as a mailto fallback. Replace with your agency inbox.
CONTACT_EMAIL=hello@your-agency-domain.example

# OPTIONAL: toggle AI personalization without removing the key
# ("off" makes /api/generate return the deterministic blueprint only).
AI_ENABLED=on

# OPTIONAL (v1.0.1): operator notification webhook for consultation requests.
# When D1 is configured, each stored request triggers a server-side POST to
# this URL (works with Slack/Discord-style incoming webhooks, a self-hosted
# receiver, or a Zapier/Make catch hook). Leave empty to run without
# notifications — the app then says honestly that requests are retrieved by
# database review. Never expose this value to the browser.
LEAD_WEBHOOK_URL=
